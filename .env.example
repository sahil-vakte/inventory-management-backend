# Example .env for Tiaknight SOAP access
# Copy this to .env and update values (DO NOT commit actual credentials to VCS)

TIA_URL=https://www.tiaknightfabrics.co.uk/api/soap/service/6
TIA_CLIENTID=Tiaknightfabrics
TIA_USERNAME=UserTiaknightfabrics341
TIA_PASSWORD=QdtsC3rm

# Optional parameters
TIA_AUTO_UPDATE=false
TIA_FILE_TYPE=xml
TIA_AUDIT_LOG_PATH=logs/remote_tiaknight_order_refs.log
TIA_SAVE_RAW_PAYLOAD=false
TIA_RAW_PAYLOAD_DIR=logs/tiaknight_payloads
TIA_GAP_RECOVERY_ATTEMPTS=2
TIA_GAP_RECOVERY_DELAY_SECONDS=0
TIA_FETCH_ORDER_DETAILS=true
TIA_RECOVER_MISSING_WITH_GET_ORDER=true

# Royal Mail Click & Drop API (DO NOT commit actual credentials)
ROYAL_MAIL_API_BASE_URL=https://api.parcel.royalmail.com/api/v1
ROYAL_MAIL_AUTH_URL=https://auth.parcel.royalmail.com/
ROYAL_MAIL_USERNAME=<your-click-drop-login-email>
ROYAL_MAIL_PASSWORD=<your-click-drop-login-password>
ROYAL_MAIL_API_KEY=<your-click-drop-api-key>
ROYAL_MAIL_CLIENT_ID=
ROYAL_MAIL_CLIENT_SECRET=
ROYAL_MAIL_OAUTH_CALLBACK_URL=https://www.wims.cloud/auth/royalmail/callback
ROYAL_MAIL_OAUTH_CALLBACK_PATH=/auth/royalmail/callback
ROYAL_MAIL_OAUTH_AUTHORIZATION_URL=
ROYAL_MAIL_OAUTH_TOKEN_URL=
ROYAL_MAIL_OAUTH_SCOPE=
ROYAL_MAIL_DEFAULT_PACKAGE_FORMAT=Parcel
ROYAL_MAIL_DEFAULT_WEIGHT_GRAMS=100
ROYAL_MAIL_CREATE_LABEL_IN_RESPONSE=true
ROYAL_MAIL_REPLACE_UNPOSTAGED_ORDERS=true
ROYAL_MAIL_LABEL_DOCUMENT_TYPE=postageLabel
ROYAL_MAIL_LABEL_INCLUDE_RETURNS_LABEL=false
ROYAL_MAIL_LABEL_INCLUDE_CN=false

# DPD Shipping API (DO NOT commit actual credentials)
DPD_INTEGRATION_ENABLED=false
DPD_API_BASE_URL=https://developers.api.customers.dpd.co.uk
DPD_CREATE_SHIPMENT_PATH=/v1/customer/shipping/shipments/domestic
DPD_TOKEN_URL=https://developers.api.customers.dpd.co.uk/v1/customer/auth/access
DPD_API_KEY=<your-dpd-sandbox-key>
DPD_API_SECRET=<your-dpd-sandbox-secret>
DPD_API_TOKEN=
DPD_CUSTOMER_ID=
DPD_BU_CODE=
DPD_DEFAULT_SERVICE_CODE=
DPD_DEFAULT_SERVICE_ELEMENT_CODES=
DPD_DEFAULT_WEIGHT_GRAMS=100
DPD_LABEL_FORMAT=PDF
DPD_LABEL_SIZE=A6
DPD_SENDER_NAME=
DPD_SENDER_COMPANY=
DPD_SENDER_COUNTRY_CODE=GB
DPD_SENDER_POSTCODE=
DPD_SENDER_CITY=
DPD_SENDER_STREET=
DPD_SENDER_ADDRESS2=
DPD_SENDER_CONTACT_NAME=
DPD_SENDER_PHONE=
DPD_SENDER_EMAIL=

# DHL Express MyDHL API (DO NOT commit actual credentials)
# MyDHL uses HTTP Basic authentication with DHL_CLIENT_ID and DHL_CLIENT_SECRET.
DHL_INTEGRATION_ENABLED=false
DHL_API_BASE_URL=https://express.api.dhl.com/mydhlapi/test
DHL_CLIENT_ID=<your-dhl-client-id>
DHL_CLIENT_SECRET=<your-dhl-client-secret>
DHL_ACCOUNT_NUMBER=<your-primary-dhl-account-number>
DHL_SECONDARY_ACCOUNT_NUMBER=<optional-secondary-dhl-account-number>
# Product codes are supplied by DHL and may differ by delivery service.
DHL_DEFAULT_PRODUCT_CODE=
# Used for WIMS STD and NEXT DAY delivery methods. Falls back to DHL_DEFAULT_PRODUCT_CODE.
DHL_NEXT_DAY_PRODUCT_CODE=
# Required when WIMS delivery method is NEXT DAY 12 / NEXT DAY BY 12.
DHL_NEXT_DAY_12_PRODUCT_CODE=
# Wholesale DHL excludes products containing any of these case-insensitive terms.
DHL_EXCLUDED_PRODUCT_KEYWORDS=fleece,lace,trimming,tape,tutu net,polycotton
DHL_DEFAULT_WEIGHT_GRAMS=100
DHL_DEFAULT_LENGTH_CM=30
DHL_DEFAULT_WIDTH_CM=20
DHL_DEFAULT_HEIGHT_CM=10
DHL_LABEL_TEMPLATE=ECOM26_84_001
# Leave false until customs commodity data has been verified for international booking.
DHL_ALLOW_INTERNATIONAL=false
DHL_SENDER_NAME=Civani Ltd
DHL_SENDER_COMPANY=Civani Ltd
DHL_SENDER_COUNTRY_CODE=GB
DHL_SENDER_POSTCODE=LE2 7SR
DHL_SENDER_CITY=Leicester
DHL_SENDER_STREET=85 Commercial Square
DHL_SENDER_ADDRESS2=
DHL_SENDER_CONTACT_NAME=
DHL_SENDER_PHONE=
DHL_SENDER_EMAIL=
